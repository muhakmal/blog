# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Old manual deploys copied out/ into the repo root; GitHub Actions deploys out/ now.
/*.html
/*.txt
/_next/
/build_log.txt
/OneSignalSDK*.js
/extracted_content/__next.*.txt

# Local Claude Code launch config
/.claude/
